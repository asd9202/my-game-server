# docker-compose.yml이 읽는 환경 변수 목록 (AGENTS.md §7.1)
# 이 파일을 같은 디렉터리의 .env로 복사한 뒤 값을 바꿔서 사용한다. .env는 커밋하지 않는다.
#   cp deploy/docker/.env.example deploy/docker/.env

# PostgreSQL 19
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=change-me
POSTGRES_DB=<postgres-db>
# 호스트에 노출할 포트 (선택, 기본 5432)
POSTGRES_PORT=5432

# Valkey 9.2 (Redis 프로토콜 호환)
VALKEY_PASSWORD=change-me
# 호스트에 노출할 포트 (선택, 기본 6379)
VALKEY_PORT=6379
