# docker-compose.yml이 읽는 환경 변수 목록 (AGENTS.md §7.1)
# 이 파일을 같은 디렉터리의 .env로 복사한 뒤 값을 바꿔서 사용한다. .env는 커밋하지 않는다.
#   cp deploy/docker/.env.example deploy/docker/.env
#
# 주의: Compose는 따옴표 없는 값 안의 `$VAR`를 변수로 치환한다.
# 값에 `$`가 들어가면 작은따옴표로 감싼다. 예) POSTGRES_PASSWORD='ab$cd'

# PostgreSQL 19
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB는 데이터 볼륨이 비어 있을 때(최초 초기화)만 적용된다.
# 이후에 값을 바꿔도 반영되지 않으므로, ALTER ROLE로 직접 바꾸거나 볼륨을 지우고 다시 초기화한다.
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=change-me
POSTGRES_DB=<postgres-db>
# 호스트에 노출할 포트 (선택, 기본 5432)
POSTGRES_PORT=5432

# Valkey 9.2 (Redis 프로토콜 호환)
# 컨테이너를 다시 만들면 바로 적용된다.
VALKEY_PASSWORD=change-me
# 호스트에 노출할 포트 (선택, 기본 6379)
VALKEY_PORT=6379
